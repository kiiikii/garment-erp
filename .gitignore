# =========================================================================
# 1. NEXT.JS / NODE (Frontend)
# =========================================================================
# Dependencies
**/node_modules/
**/pnpm-lock.yaml
**/yarn.lock
**/package-lock.json

# Next.js build output
**/.next/
**/out/

# Production build artifacts
**/build/
**/dist/

# Debug logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# =========================================================================
# 2. GO / GOLANG (Backend)
# =========================================================================
# Compiled binaries and executables
*.exe
*.exe~
*.dll
*.so
*.dylib
**/backend_bin
**/main

# Go test coverage files
*.out
*.prof

# Go vendor directory (if used)
**/vendor/

# =========================================================================
# 3. ENVIRONMENT VARIABLES & SECRETS (Crucial!)
# =========================================================================
# Local env files containing API keys, database passwords, tokens
.env
.env*.local
**/.env
**/.env*.local

# =========================================================================
# 4. SYSTEM / IDE FILES
# =========================================================================
.DS_Store
Thumbs.db
**/.vscode/
**/.idea/